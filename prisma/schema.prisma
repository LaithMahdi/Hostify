generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(GUEST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Guesthouse {
  id            Int      @id @default(autoincrement())
  name          String
  address       String
  region        String
  numberOfRooms Int
  description   String   @default("")
  rating        Float?
  createdAt     DateTime @default(now())
}
model Room {
  id             Int       @id @default(autoincrement())
  nbRooms        Int
  type           RoomType
  pricePerNight  Float
  status         RoomStatus
  description    String    @default("")
  createdAt      DateTime  @default(now())
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  FAMILY
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum Role {
  GUEST
  USER
  OWNER
  ADMIN
}
