generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(GUEST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms     Room[]
  guestHouses GuestHouse[]
}

model Equipment {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String
  description String?
  isActive    Boolean  @default(true)
  rooms       Room[]

  createdAt   DateTime @default(now())
}

model GuestHouse {
  id            Int      @id @default(autoincrement())
  name          String
  address       String
  region        String
  description   String?
  rating        Float   @default(0)
  hasParking      Boolean @default(false)
  isPetFriendly   Boolean @default(false)
  rooms         Room[] 
  images        Image[]
  contacts      Contact[]

  owner         User     @relation(fields: [ownerId], references: [id])
  ownerId       String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Room {
  id             Int       @id @default(autoincrement())
  roomNumber     Int
  type           RoomType
  pricePerNight  Float
  status         RoomStatus
  capacity       Int
  hasBalcony      Boolean    @default(false)
  description    String?
  guestHouseId   Int?     
  images         Image[]
  equipment      Equipment[]
  guestHouse  GuestHouse? @relation(fields: [guestHouseId], references: [id], onDelete: Cascade)
  isActive       Boolean    @default(true)

  owner          User       @relation(fields: [ownerId], references: [id])
  ownerId        String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Contact {
  id           Int      @id @default(autoincrement())
  type         ContactType 
  value        String   
  guestHouseId Int    
  guestHouse   GuestHouse? @relation(fields: [guestHouseId], references: [id]) 
  createdAt    DateTime @default(now())
}

model Image {
  id           Int      @id @default(autoincrement())
  url          String

  guestHouseId Int?    
  guestHouse   GuestHouse? @relation(fields: [guestHouseId], references: [id]) 
  roomId       Int?
  room         Room? @relation(fields: [roomId], references: [id])

  createdAt    DateTime @default(now())
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE
  FAMILY
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum Role {
  GUEST
  USER
  OWNER
  ADMIN
}

enum ContactType {
  PHONE
  FACEBOOK
  INSTAGRAM
  EMAIL
  WEBSITE
}